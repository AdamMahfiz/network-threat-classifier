# Database Configuration (SQLite)
# SQLite database path (relative to project root)
SQLITE_DATABASE_PATH=data/threat_classifier.db

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Email Configuration (for alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Alert Configuration
ALERT_EMAIL=admin@example.com

# Live Email Alert Settings
# Enable/disable sending email alerts
EMAIL_ALERTS_ENABLED=True
# Cooldown in seconds between live alert emails
EMAIL_ALERT_COOLDOWN_SECONDS=120
# Optional: comma-separated recipients for alerts
# Defaults to MAIL_DEFAULT_SENDER if unset
ALERT_RECIPIENTS=admin@example.com
